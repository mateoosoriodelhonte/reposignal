# Copy to `.env.local` for development. Never commit `.env.local`.

# ---------------------------------------------------------------------------
# GitHub API
# ---------------------------------------------------------------------------
# A classic or fine-grained personal access token with NO scopes selected.
# RepoSignal only reads public data; an unscoped token raises the rate limit
# from 60 to 5,000 requests/hour without granting any access to your account.
#
# Create one at: https://github.com/settings/tokens
# For local development you can reuse the GitHub CLI's token:
#   echo "GITHUB_TOKEN=$(gh auth token)" >> .env.local
#
# This value is read on the server only and is never sent to the browser.
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string used by Prisma for analysis caching and history.
# RepoSignal runs without it — persistence falls back to an in-memory store —
# but cached analyses will not survive a restart.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reposignal?schema=public"

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# How long a cached analysis is served before a refresh is offered (minutes).
# ANALYSIS_FRESHNESS_MINUTES=15

# Maximum GitHub API requests a single analysis may spend.
# GITHUB_REQUEST_BUDGET=40
